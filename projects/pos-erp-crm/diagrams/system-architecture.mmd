flowchart TB
    user[門市與後台使用者] --> ui[POS Web UI]

    subgraph pos[POS System]
        ui --> app[Laravel Application]
        app --> catalog[Catalog / Item / Variant]
        app --> operations[Sales / Inventory / Purchasing]
        app --> manufacturing[Manufacturing / BOM]
        catalog --> db[(POS MySQL)]
        operations --> db
        manufacturing --> db
        app --> outbox[Integration Outbox]
        app --> adapters[Print / RFID / External Adapters]
    end

    outbox --> queue[Queue Worker]
    queue --> retry[Retry / Backoff / Idempotency]
    retry --> sync[POS-to-CRM Sync Worker]

    subgraph crm[CRM System]
        sync --> crmApi[CRM API]
        crmApi --> crmDb[(CRM Database)]
        crmApi --> tenant[Multi-tenant Domain]
    end

    scheduler[Scheduler] --> queue
